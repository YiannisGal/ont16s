/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run YiannisGal/ont16s -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    // GitHub-hosted runners for private repos: 2 CPUs, ~7.8 GB RAM
    resourceLimits = [
        cpus: 2,
        memory: '7.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    // 546-read subset of a public ONT Zymo MSPlus SUP chunk (YiannisGal/ont16s-test-datasets, CC BY-NC 4.0)
    input = "${projectDir}/assets/test/samplesheet_test.csv"
    emu_db = "https://raw.githubusercontent.com/YiannisGal/ont16s-test-datasets/main/emu_db_zymo_genera.tar.gz"
}
