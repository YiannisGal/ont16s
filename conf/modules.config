/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Read preparation: intermediate files, not published (they stay in work/)
    withName: 'SAMTOOLS_CAT|SAMTOOLS_FASTQ|CAT_FASTQ' {
        publishDir = [ enabled: false ]
    }

    withName: 'NANOPLOT_RAW' {
        ext.args   = { "-p ${meta.id}_raw_ --tsv_stats" }
        publishDir = [ path: { "${params.outdir}/qc/nanoplot/raw" }, mode: params.publish_dir_mode ]
    }

    withName: 'CHOPPER' {
        ext.args2  = { [
            "--minlength ${params.min_read_length}",
            "--maxlength ${params.max_read_length}",
            params.min_read_qual > 0 ? "--quality ${params.min_read_qual}" : ''
        ].join(' ').trim() }
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [ enabled: false ]
    }

    withName: 'NANOPLOT_FILTERED' {
        ext.args   = { "-p ${meta.id}_filtered_ --tsv_stats" }
        publishDir = [ path: { "${params.outdir}/qc/nanoplot/filtered" }, mode: params.publish_dir_mode ]
    }

    withName: 'UNTAR_EMU_DB' {
        publishDir = [ enabled: false ]
    }

    // Emu: CPU-bound in minimap2, memory-light (ST-001/ST-002: peak 2.6-4.0 GB)
    withName: 'EMU_ABUNDANCE' {
        ext.args   = { "--type ${params.emu_type} --keep-counts --output-unclassified" }
        cpus       = { 8 * task.attempt }
        memory     = { 8.GB * task.attempt }
        time       = { 8.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/emu" },
            mode: params.publish_dir_mode,
            pattern: '*_rel-abundance.tsv'
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

}
